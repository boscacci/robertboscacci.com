{
    admin off
    auto_https disable_redirects
    servers {
        protocols h1 h2
    }
}

https://howlong.robertboscacci.com:9452 {
    bind 127.0.0.1
    tls {
        dns route53 {
            region us-west-2
            hosted_zone_id Z1BDNRWTPWQNUU
        }
        resolvers 1.1.1.1 8.8.8.8
    }
    header {
        Cache-Control "no-store"
        X-Robots-Tag "noindex, nofollow, noarchive"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Strict-Transport-Security "max-age=31536000"
        Content-Security-Policy "default-src 'none'; style-src 'self'; script-src 'self'; connect-src 'self' {$HOWLONG_API_ORIGIN}; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
    }
    handle /runtime.json {
        header Content-Type "application/json; charset=utf-8"
        respond `{"apiOrigin":"{$HOWLONG_API_ORIGIN}"}` 200
    }
    @scripts path /app.mjs /calendar.mjs
    header @scripts Content-Type "text/javascript; charset=utf-8"
    @static path / /app.mjs /calendar.mjs /style.css
    handle @static {
        root * /srv/howlong
        file_server
    }
    respond /healthz "howlong-edge-ok" 200
    respond 404
}
